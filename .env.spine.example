# --- OpenMuse on Spine: sample mode (real UI, fictional data) -----------------
# Copy to ~/openmuse/.env on Spine. deploy.sh does this for you and fills in
# __OPENMUSE_API_URL__ / __OPENMUSE_WEB_URL__ with the real tailscale URLs.
# Ports: web UI defaults to tailscale-serve :8445, API to :8446
# (override with OPENMUSE_WEB_PORT / OPENMUSE_API_PORT if taken).
WORKSPACE_MODE=sample
AGENT_BACKEND=sample

PORT=8787
HOST=127.0.0.1
# Public URL of the API as seen from the iPhone (tailscale serve, see README).
# deploy.sh replaces __OPENMUSE_API_URL__ with the real value.
PUBLIC_API_URL=__OPENMUSE_API_URL__
# The web UI origin — must match the tailscale-serve URL of the UI.
ALLOWED_ORIGINS=__OPENMUSE_WEB_URL__
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=true

# --- Model backend (Phase 2) --------------------------------------------------
# Flip these when ready to wire the real agent. Provider keys stay on Spine.
# AGENT_BACKEND=model
# MODEL=anthropic/claude-sonnet-4-5-20250929
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Browser worker -----------------------------------------------------------
BROWSER_WORKER_URL=http://127.0.0.1:8790
# deploy.sh generates this automatically. 32+ random chars.
WORKER_TOKEN=REPLACE_ME_GENERATED_BY_DEPLOY_SH
WORKER_DATA_DIR=.openmuse/browser-profiles
WORKER_HOST=127.0.0.1

# --- CopilotKit Intelligence (required in EVERY mode) --------------------------
# Get it once on Spine:
#   npx copilotkit@latest login && npx copilotkit@latest project select
CPK_INTELLIGENCE_API_KEY=PASTE_YOUR_COPILOTKIT_INTELLIGENCE_KEY_HERE

# --- Optional Linux computer (Phase 2+, needs Docker image built) -------------
# docker build -t openmuse-computer:local apps/computer
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local

# --- Optional live Google workspace (Phase 2+) --------------------------------
# WORKSPACE_MODE=live
# OPENMUSE_ACCESS_KEY=  # random secret, at least 24 characters
# TOKEN_ENCRYPTION_KEY= # 32 random bytes, base64
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback: ${PUBLIC_API_URL}/api/google/callback
